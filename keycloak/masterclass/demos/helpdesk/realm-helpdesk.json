{
  "realm": "helpdesk",
  "displayName": "Nordlicht Energie AG",
  "displayNameHtml": "<span class=\"nl-brand\">Nordlicht Energie AG</span>",
  "enabled": true,

  "loginTheme": "nordlicht",
  "adminTheme": "nordlicht",
  "accountTheme": "nordlicht",

  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,

  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",

  "eventsEnabled": true,
  "eventsExpiration": 86400,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "groups": [
    { "name": "Vertrieb" },
    { "name": "Netzbetrieb" },
    { "name": "Abrechnung", "realmRoles": ["abrechnung"] }
  ],

  "roles": {
    "realm": [
      {
        "name": "helpdesk-agent",
        "description": "Darf Benutzer verwalten, ist aber ausdruecklich kein Realm-Admin.",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "view-users",
              "manage-users",
              "impersonation",
              "view-events"
            ]
          }
        }
      },
      {
        "name": "helpdesk-search-only",
        "description": "Negativbeispiel: nur query-users. Reicht zum Suchen, nicht zum Ansehen oder Aendern.",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "query-users"
            ]
          }
        }
      },
      {
        "name": "abrechnung",
        "description": "Fachrolle: Zugriff auf die Abrechnungsanwendung. Bewusst KEINE Admin-Rolle - der Helpdesk kann sie trotzdem vergeben."
      }
    ]
  },

